{
  "name": "vscode-hacker-rest-control",
  "displayName": "Hacker REST Control",
  "description": "This extension allows you to remotely control Visual Studio Code via a REST endpoint, taking automation to the next level.",
  "publisher": "lamnguyenx",
  "license": "MIT",
  "version": "2026.9.26",
  "engines": {
    "vscode": "^1.100.0"
  },
  "badges": [
    {
      "description": "version",
      "url": "https://img.shields.io/github/package-json/v/lamnguyenx/vscode-hacker-rest-control?color=green&label=vscode-hacker-rest-control&style=flat-square",
      "href": "https://github.com/lamnguyenx/vscode-hacker-rest-control"
    },
    {
      "description": "Buy me a coffee",
      "url": "https://img.shields.io/badge/Buy%20me%20a%20coffee-$3-blue?logo=buy-me-a-coffee&style=flat-square",
      "href": "https://www.buymeacoffee.com/dpar39"
    }
  ],
  "icon": "assets/logo.drawio.png",
  "galleryBanner": {
    "color": "#132136",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lamnguyenx/vscode-hacker-rest-control"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "REST Control: Configuration",
      "properties": {
        "restRemoteControl.enable": {
          "type": "boolean",
          "default": true,
          "description": "Specifies if you want enable/disable the remote control globally or for a workspace."
        },
        "restRemoteControl.port": {
          "type": "number",
          "default": 0,
          "description": "Specifies the port on which the REST API server will start. If not specified, it will pick one based on a hash of the current workspace path if possible."
        },
        "restRemoteControl.fallbacks": {
          "type": "array",
          "default": [],
          "description": "Allows you to specify fallback ports when the main one is taken."
        }
      },
      "commands": [
        {
          "command": "restRemoteControl.openSettings",
          "title": "Remote Control: Open settings"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "test-compile": "tsc -p ./",
    "test-watch": "tsc -watch -p ./",
    "pretest": "npm run test-compile && npm run lint",
    "lint": "eslint src && npx prettier --check './**/*.{js,ts}'",
    "test": "xvfb-run -a node ./out/test/runTest.js",
    "format": "npx prettier --write './**/*.{js,jsx,mjs,cjs,ts,tsx}'"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/tcp-port-used": "^1.0.4",
    "@types/vscode": "^1.100.0",
    "@types/ws": "8.18.1",
    "@vscode/test-cli": "0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/vsce": "^2.32.0",
    "eslint": "^9.16.0",
    "glob": "^11.0.1",
    "mocha": "^11.1.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "webpack": "^5.97.0",
    "webpack-cli": "^6.0.1",
    "ws": "^8.18.1"
  },
  "dependencies": {
    "tcp-port-used": "^1.0.2"
  },
  "overrides": {}
}
